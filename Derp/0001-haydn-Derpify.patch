From 717d0e425e96b9e7ea083a850c385b0bd5524424 Mon Sep 17 00:00:00 2001
From: 1xtAsh <ashraykrsingh321@gmail.com>
Date: Thu, 31 Oct 2024 14:09:04 +0530
Subject: [PATCH] haydn: Derpify !

---
 AndroidProducts.mk                            |  2 +-
 derp_haydn.mk                                 | 34 +++++++++++++++++++
 .../apps/Settings/res/values/config.xml       |  6 ++--
 3 files changed, 38 insertions(+), 4 deletions(-)
 create mode 100644 derp_haydn.mk

diff --git a/AndroidProducts.mk b/AndroidProducts.mk
index 2e427e3..5ad36d8 100644
--- a/AndroidProducts.mk
+++ b/AndroidProducts.mk
@@ -5,5 +5,5 @@
 #
 
 PRODUCT_MAKEFILES := \
-    $(LOCAL_DIR)/lineage_haydn.mk
+    $(LOCAL_DIR)/derp_haydn.mk
 
diff --git a/derp_haydn.mk b/derp_haydn.mk
new file mode 100644
index 0000000..d0a5f43
--- /dev/null
+++ b/derp_haydn.mk
@@ -0,0 +1,34 @@
+#
+# Copyright (C) 2021 The LineageOS Project
+#
+# SPDX-License-Identifier: Apache-2.0
+#
+
+# Inherit from those products. Most specific first.
+$(call inherit-product, $(SRC_TARGET_DIR)/product/core_64_bit.mk)
+$(call inherit-product, $(SRC_TARGET_DIR)/product/full_base_telephony.mk)
+
+# Inherit from haydn device
+$(call inherit-product, device/xiaomi/haydn/device.mk)
+
+# Inherit some common Derpfest stuff.
+$(call inherit-product, vendor/derp/config/common_full_phone.mk)
+
+PRODUCT_BRAND := Xiaomi
+PRODUCT_DEVICE := haydn
+PRODUCT_MANUFACTURER := Xiaomi
+PRODUCT_MODEL := M2012K11G
+PRODUCT_NAME := derp_haydn
+
+PRODUCT_SYSTEM_NAME := haydn_global
+PRODUCT_SYSTEM_DEVICE := haydn
+
+PRODUCT_BUILD_PROP_OVERRIDES += \
+    BuildDesc=$(call normalize-path-list, "haydn_global-user 14 UKQ1.231207.002 V816.0.2.0.UKKMIXM release-keys") \
+    DeviceName=$(PRODUCT_SYSTEM_DEVICE) \
+    DeviceProduct=$(PRODUCT_SYSTEM_NAME)
+
+BUILD_FINGERPRINT := Xiaomi/haydn_global/haydn:14/UKQ1.231207.002/V816.0.2.0.UKKMIXM:user/release-keys
+
+PRODUCT_GMS_CLIENTID_BASE := android-xiaomi
+
diff --git a/overlay/packages/apps/Settings/res/values/config.xml b/overlay/packages/apps/Settings/res/values/config.xml
index b15d5b2..3d5713e 100644
--- a/overlay/packages/apps/Settings/res/values/config.xml
+++ b/overlay/packages/apps/Settings/res/values/config.xml
@@ -22,7 +22,7 @@
     <!-- Whether to show min refresh rate in display settings -->
     <bool name="config_show_min_refresh_rate_switch">true</bool>
     
-    <!-- Lineage-Ext maintainer -->
-    <string name="maintainer_name">AshraySingh</string>
-    <string name="ext_settings_summary">Mi 11x Pro/Redmi K40 Pro</string>
+        <!-- DerpFest maintainer -->
+    <string name="maintainer_name">AntiMiUi</string>
+    <string name="maintainer_telegram">https://t.me/Anti_MiUi</string>
 </resources>
-- 
2.34.1

